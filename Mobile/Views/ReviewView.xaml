<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mobile.Views.ReviewView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dtos="clr-namespace:Mobile.DTOs"
    Title="Reviews"
    BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!--  Picker de Ordenação e Filtro  -->
        <Grid
            Grid.Row="0"
            Padding="12,8"
            BackgroundColor="White"
            ColumnDefinitions="*, *"
            ColumnSpacing="8">
            <Picker
                x:Name="pckOrdenacao"
                Title="Ordenação"
                SelectedIndexChanged="OnFiltroChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Time (newest first)</x:String>
                        <x:String>Time (oldest first)</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Picker
                x:Name="pckFiltroEstrelas"
                Title="Filtrar Estrelas"
                Grid.Column="1"
                SelectedIndexChanged="OnFiltroChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Todas</x:String>
                        <x:String>5 estrelas</x:String>
                        <x:String>4 estrelas</x:String>
                        <x:String>3 estrelas</x:String>
                        <x:String>2 estrelas</x:String>
                        <x:String>1 estrela</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
        </Grid>

        <BoxView
            Grid.Row="1"
            HeightRequest="1"
            Color="#E0E0E0" />

        <!--  Lista de Comentários  -->
        <CollectionView
            x:Name="cvListaComentarios"
            Grid.Row="2"
            Margin="12,8">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dtos:ReviewDto">
                    <Border
                        Margin="0,0,0,10"
                        Padding="12"
                        BackgroundColor="White"
                        Stroke="#E0E0E0"
                        StrokeShape="RoundRectangle 8">
                        <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="6">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                <Border
                                    Margin="0,0,10,0"
                                    HeightRequest="36"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 18"
                                    WidthRequest="36">
                                    <Image Aspect="AspectFill" Source="{Binding AvatarUrl}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        Text="{Binding UserName}"
                                        TextColor="#222" />
                                    <Label
                                        FontSize="11"
                                        Text="{Binding ReviewTime}"
                                        TextColor="#888" />
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="2"
                                    FontAttributes="Bold"
                                    Text="{Binding Rating, StringFormat='⭐ {0}'}"
                                    TextColor="#FF8800"
                                    VerticalOptions="Center" />
                            </Grid>

                            <Label
                                Grid.Row="1"
                                FontSize="13"
                                LineBreakMode="WordWrap"
                                Text="{Binding ReviewContent}"
                                TextColor="#333" />

                            <CollectionView
                                Grid.Row="2"
                                HeightRequest="50"
                                ItemsSource="{Binding ImageUrls}">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout ItemSpacing="6" Orientation="Horizontal" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border
                                            HeightRequest="50"
                                            Stroke="#DDD"
                                            StrokeShape="RoundRectangle 4"
                                            WidthRequest="50">
                                            <Image Aspect="AspectFill" Source="{Binding .}" />
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!--  Form de Novo Comentário  -->
        <Border
            Grid.Row="3"
            Padding="12"
            BackgroundColor="White"
            Stroke="#E0E0E0">
            <VerticalStackLayout Spacing="8">
                <Label
                    FontAttributes="Bold"
                    FontSize="14"
                    Text="Deixe sua avaliação"
                    TextColor="#222" />

                <HorizontalStackLayout x:Name="layoutEstrelas" Spacing="8">
                    <Label
                        FontSize="24"
                        Text="★"
                        TextColor="#FF8800">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="1" Tapped="OnStarTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label
                        FontSize="24"
                        Text="★"
                        TextColor="#FF8800">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="2" Tapped="OnStarTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label
                        FontSize="24"
                        Text="★"
                        TextColor="#FF8800">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="3" Tapped="OnStarTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label
                        FontSize="24"
                        Text="★"
                        TextColor="#FF8800">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="4" Tapped="OnStarTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label
                        FontSize="24"
                        Text="★"
                        TextColor="#FF8800">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="5" Tapped="OnStarTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <Entry
                    x:Name="txtComentario"
                    Placeholder="Escreva um comentário (mínimo 5 caracteres)"
                    TextChanged="TxtComentario_TextChanged" />
                <Label
                    x:Name="lblContador"
                    FontSize="11"
                    Text="0/15 caracteres (mínimo 5)"
                    TextColor="#AA0000" />

                <HorizontalStackLayout
                    x:Name="layoutPreviewFotos"
                    IsVisible="False"
                    Spacing="6" />

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <Button
                        BackgroundColor="#E0E0E0"
                        Clicked="OnAnexarFotoClicked"
                        HeightRequest="40"
                        Text="📷 Anexar Foto"
                        TextColor="#333" />
                    <Button
                        x:Name="btnEnviar"
                        Grid.Column="1"
                        BackgroundColor="#0066CC"
                        Clicked="OnEnviarClicked"
                        HeightRequest="40"
                        IsEnabled="False"
                        Text="Enviar"
                        TextColor="White" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>