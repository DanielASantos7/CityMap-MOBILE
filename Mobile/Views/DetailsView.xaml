<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mobile.Views.DetailsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalhes"
    BackgroundColor="White">

    <ScrollView Padding="15">
        <VerticalStackLayout Spacing="15">

            <!--  IMAGEM PRINCIPAL  -->
            <Image
                x:Name="imgCapa"
                Aspect="AspectFill"
                HeightRequest="200"
                HorizontalOptions="Fill" />

            <!--  TITULO, TAG E RATING  -->
            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                <Label
                    x:Name="lblNome"
                    Grid.Column="0"
                    FontAttributes="Bold"
                    FontSize="20"
                    TextColor="Black" />

                <Border
                    x:Name="brdTipo"
                    Grid.Column="1"
                    BackgroundColor="#1E88E5"
                    StrokeShape="RoundRectangle 4"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                    <Label
                        x:Name="lblTipo"
                        Padding="6,2"
                        FontAttributes="Bold"
                        FontSize="12"
                        TextColor="White" />
                </Border>

                <HorizontalStackLayout
                    Grid.Column="2"
                    Spacing="2"
                    VerticalOptions="Center">
                    <Image HeightRequest="16" Source="estrela.png" />
                    <Label
                        x:Name="lblRating"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="Gray" />
                </HorizontalStackLayout>
            </Grid>

            <Label
                x:Name="lblDistancia"
                FontSize="14"
                TextColor="Gray" />

            <!--  CAMPOS ESPECÍFICOS DE RESTAURANTE  -->
            <Grid
                x:Name="gridRestaurante"
                ColumnDefinitions="*, *"
                IsVisible="False"
                RowDefinitions="Auto, Auto"
                RowSpacing="10">

                <Label
                    x:Name="lblCustoMedio"
                    Grid.Row="0"
                    Grid.Column="0"
                    FontSize="13"
                    TextColor="Black" />
                <Label
                    x:Name="lblHorarioRestaurante"
                    Grid.Row="0"
                    Grid.Column="1"
                    FontSize="13"
                    TextColor="Black" />
                <Label
                    x:Name="lblEstacionamento"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    FontSize="13"
                    TextColor="Black" />
            </Grid>

            <!--  CAMPOS ESPECÍFICOS DE ATRAÇÃO (SCENIC SPOT)  -->
            <Grid
                x:Name="gridAtracao"
                ColumnDefinitions="*, *"
                IsVisible="False"
                RowDefinitions="Auto, Auto"
                RowSpacing="10">

                <Label
                    x:Name="lblHorarioAtracao"
                    Grid.Row="0"
                    Grid.Column="0"
                    FontSize="13"
                    TextColor="Black" />
                <Label
                    x:Name="lblPrecoIngresso"
                    Grid.Row="0"
                    Grid.Column="1"
                    FontSize="13"
                    TextColor="Black" />
                <Label
                    x:Name="lblMelhorEpoca"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    FontSize="13"
                    TextColor="Black" />
            </Grid>

            <BoxView
                Margin="0,10"
                HeightRequest="1"
                Color="#E0E0E0" />

            <!--  BLOCO DE USUÁRIO NÃO LOGADO  -->
            <VerticalStackLayout
                x:Name="layoutDeslogado"
                Margin="0,20"
                HorizontalOptions="Center"
                IsVisible="True"
                Spacing="15">

                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="Faça login para ver as avaliações"
                    TextColor="Black" />

                <Button
                    BackgroundColor="#1E88E5"
                    Clicked="OnEntrarClicked"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    Text="ENTRAR"
                    TextColor="White"
                    WidthRequest="150" />
            </VerticalStackLayout>

            <!--  BLOCO DE AVALIAÇÕES (EXIBIDO APENAS QUANDO LOGADO)  -->
            <VerticalStackLayout
                x:Name="layoutLogado"
                IsVisible="False"
                Spacing="10">

                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Avaliações de Usuários"
                    TextColor="Black" />

                <CollectionView x:Name="cvAvaliacoes" HeightRequest="180">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,5"
                                Padding="10"
                                BackgroundColor="#F5F5F5"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0">
                                <Grid
                                    ColumnDefinitions="Auto, *"
                                    ColumnSpacing="10"
                                    RowDefinitions="Auto, Auto">
                                    <Image
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Aspect="AspectFill"
                                        HeightRequest="40"
                                        Source="{Binding AvatarUrl}"
                                        WidthRequest="40" />
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                        <Label
                                            FontAttributes="Bold"
                                            Text="{Binding UserName}"
                                            TextColor="Black" />
                                        <Label
                                            FontSize="13"
                                            Text="{Binding ReviewContent}"
                                            TextColor="DarkGray" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button
                    BackgroundColor="Transparent"
                    BorderColor="#1E88E5"
                    BorderWidth="1"
                    Clicked="OnVerMaisClicked"
                    CornerRadius="8"
                    Text="VER MAIS"
                    TextColor="#1E88E5" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>