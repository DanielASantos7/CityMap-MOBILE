<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mobile.Views.DetailsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Mobile.Views"
    Title="Detalhes do Local"
    BackgroundColor="#F8F9FA">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">

            <!--  1. IMAGEM DE CAPA COM BORDAS ARREDONDADAS  -->
            <Border
                HeightRequest="220"
                HorizontalOptions="Fill"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 12">
                <Image
                    x:Name="imgCapa"
                    Aspect="AspectFill"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />
            </Border>

            <!--  2. HEADER: TÍTULO, TAG E RATING  -->
            <Grid
                ColumnDefinitions="*, Auto, Auto"
                ColumnSpacing="8"
                VerticalOptions="Center">
                <Label
                    x:Name="lblNome"
                    Grid.Column="0"
                    FontAttributes="Bold"
                    FontSize="22"
                    LineBreakMode="TailTruncation"
                    TextColor="#1A1A1A"
                    VerticalOptions="Center" />

                <Border
                    x:Name="brdTipo"
                    Grid.Column="1"
                    Padding="8,4"
                    BackgroundColor="#0066CC"
                    StrokeShape="RoundRectangle 6"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                    <Label
                        x:Name="lblTipo"
                        FontAttributes="Bold"
                        FontSize="11"
                        TextColor="White" />
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="8,4"
                    BackgroundColor="#FFF8E7"
                    Stroke="#FFC107"
                    StrokeShape="RoundRectangle 6"
                    VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label
                            FontSize="13"
                            Text="★"
                            TextColor="#FF8800"
                            VerticalOptions="Center" />
                        <Label
                            x:Name="lblRating"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="#FF8800"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!--  DISTÂNCIA  -->
            <HorizontalStackLayout Margin="0,-6,0,0" Spacing="6">
                <Label
                    FontSize="12"
                    Text="📍"
                    VerticalOptions="Center" />
                <Label
                    x:Name="lblDistancia"
                    FontSize="13"
                    TextColor="#666666"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!--  3. BLOCO DE INFORMAÇÕES TÉCNICAS (RESTAURANTE)  -->
            <Border
                x:Name="gridRestaurante"
                Padding="14"
                BackgroundColor="White"
                IsVisible="False"
                Stroke="#E0E0E0"
                StrokeShape="RoundRectangle 10">
                <Grid
                    ColumnDefinitions="*, *"
                    ColumnSpacing="10"
                    RowDefinitions="Auto, Auto"
                    RowSpacing="10">

                    <VerticalStackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Spacing="2">
                        <Label
                            FontSize="11"
                            Text="Faixa de Preço"
                            TextColor="#888888" />
                        <Label
                            x:Name="lblCustoMedio"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="#222222" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Row="0"
                        Grid.Column="1"
                        Spacing="2">
                        <Label
                            FontSize="11"
                            Text="Funcionamento"
                            TextColor="#888888" />
                        <Label
                            x:Name="lblHorarioRestaurante"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="#222222" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Spacing="2">
                        <Label
                            FontSize="11"
                            Text="Estacionamento"
                            TextColor="#888888" />
                        <Label
                            x:Name="lblEstacionamento"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="#222222" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!--  4. BLOCO DE INFORMAÇÕES TÉCNICAS (ATRAÇÃO / SCENIC SPOT)  -->
            <Border
                x:Name="gridAtracao"
                Padding="14"
                BackgroundColor="White"
                IsVisible="False"
                Stroke="#E0E0E0"
                StrokeShape="RoundRectangle 10">
                <Grid
                    ColumnDefinitions="*, *"
                    ColumnSpacing="10"
                    RowDefinitions="Auto, Auto"
                    RowSpacing="10">

                    <VerticalStackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Spacing="2">
                        <Label
                            FontSize="11"
                            Text="Horário de Abertura"
                            TextColor="#888888" />
                        <Label
                            x:Name="lblHorarioAtracao"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="#222222" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Row="0"
                        Grid.Column="1"
                        Spacing="2">
                        <Label
                            FontSize="11"
                            Text="Ingresso"
                            TextColor="#888888" />
                        <Label
                            x:Name="lblPrecoIngresso"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="#222222" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Spacing="2">
                        <Label
                            FontSize="11"
                            Text="Melhor Época para Visita"
                            TextColor="#888888" />
                        <Label
                            x:Name="lblMelhorEpoca"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="#222222" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <BoxView
                Margin="0,4"
                HeightRequest="1"
                Color="#E5E7EB" />

            <!--  5. BLOCO DE USUÁRIO NÃO LOGADO  -->
            <Border
                x:Name="layoutDeslogado"
                Margin="0,8"
                Padding="20"
                BackgroundColor="White"
                IsVisible="True"
                Stroke="#E0E0E0"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="12">
                    <Label
                        FontAttributes="Bold"
                        FontSize="15"
                        HorizontalOptions="Center"
                        Text="🔒 Faça login para ver as avaliações"
                        TextColor="#333333" />

                    <Label
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        Text="Acesse sua conta para conferir a opinião da comunidade sobre este local."
                        TextColor="#666666" />

                    <Button
                        Margin="0,4,0,0"
                        BackgroundColor="#0066CC"
                        Clicked="OnEntrarClicked"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        HeightRequest="42"
                        Text="ENTRAR AGORA"
                        TextColor="White"
                        WidthRequest="180" />
                </VerticalStackLayout>
            </Border>

            <!--  6. BLOCO DE AVALIAÇÕES (EXIBIDO APENAS QUANDO LOGADO)  -->
            <VerticalStackLayout
                x:Name="layoutLogado"
                IsVisible="False"
                Spacing="12">

                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="17"
                        Text="Avaliação em Destaque"
                        TextColor="#1A1A1A"
                        VerticalOptions="Center" />

                    <Button
                        Grid.Column="1"
                        Padding="0"
                        BackgroundColor="Transparent"
                        Clicked="OnVerMaisClicked"
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="Ver Todas &gt;"
                        TextColor="#0066CC" />
                </Grid>

                <!--  CONTAINER DO CARD PREVIEW  -->
                <CollectionView x:Name="cvAvaliacoes" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="views:ReviewDto">
                            <Border
                                Padding="14"
                                BackgroundColor="White"
                                Stroke="#E0E0E0"
                                StrokeShape="RoundRectangle 12">
                                <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="10">

                                    <!--  Linha 1: Avatar, Nome, Data e Nota  -->
                                    <Grid
                                        Grid.Row="0"
                                        ColumnDefinitions="44, *, Auto"
                                        ColumnSpacing="10"
                                        VerticalOptions="Center">
                                        <Border
                                            Grid.Column="0"
                                            HeightRequest="44"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 22"
                                            WidthRequest="44">
                                            <Image Aspect="AspectFill" Source="{Binding AvatarUrl}" />
                                        </Border>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                Text="{Binding UserName}"
                                                TextColor="#222222" />
                                            <Label
                                                FontSize="11"
                                                Text="{Binding ReviewTime}"
                                                TextColor="#777777" />
                                        </VerticalStackLayout>

                                        <Border
                                            Grid.Column="2"
                                            Padding="6,2"
                                            BackgroundColor="#FFF8E7"
                                            Stroke="#FFC107"
                                            StrokeShape="RoundRectangle 6"
                                            VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                                <Label
                                                    FontSize="12"
                                                    Text="★"
                                                    TextColor="#FF8800"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    Text="{Binding Rating}"
                                                    TextColor="#FF8800"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>

                                    <!--  Linha 2: Conteúdo  -->
                                    <Label
                                        Grid.Row="1"
                                        FontSize="13"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding ReviewContent}"
                                        TextColor="#444444" />

                                    <!--  Linha 3: Galeria Horizontal de Fotos (Com x:DataType="x:String")  -->
                                    <CollectionView
                                        Grid.Row="2"
                                        HeightRequest="64"
                                        ItemsSource="{Binding ImageUrls}">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout ItemSpacing="8" Orientation="Horizontal" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border
                                                    HeightRequest="64"
                                                    Stroke="#E0E0E0"
                                                    StrokeShape="RoundRectangle 8"
                                                    WidthRequest="64">
                                                    <Image Aspect="AspectFill" Source="{Binding .}" />
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>

                                    <!--  Linha 4: Curtidas  -->
                                    <HorizontalStackLayout
                                        Grid.Row="3"
                                        Spacing="6"
                                        VerticalOptions="Center">
                                        <Label
                                            FontSize="12"
                                            Text="👍"
                                            VerticalOptions="Center" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding LikeCount, StringFormat='{0} pessoas acharam útil'}"
                                            TextColor="#777777"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>