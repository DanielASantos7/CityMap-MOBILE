<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mobile.Views.LoginView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Login">
    <VerticalStackLayout
        Padding="25"
        Spacing="20"
        VerticalOptions="Center">
        <Border
            Padding="5,0"
            Stroke="#CCCCCC"
            StrokeShape="RoundRectangle 4"
            StrokeThickness="1">
            <Entry
                x:Name="txtUsername"
                Placeholder="Username"
                Text="user1"
                TextColor="Black" />
        </Border>
        <Border
            Padding="5,0"
            Stroke="#CCCCCC"
            StrokeShape="RoundRectangle 4"
            StrokeThickness="1">
            <Entry
                x:Name="txtPassword"
                IsPassword="True"
                Placeholder="Password"
                Text="123456"
                TextColor="Black" />
        </Border>

        <Button
            Margin="0,10,0,0"
            BackgroundColor="#1E88E5"
            CharacterSpacing="2"
            Clicked="Button_Clicked"
            CornerRadius="8"
            FontAttributes="Bold"
            HeightRequest="45"
            Text="LOGIN"
            TextColor="White" />
    </VerticalStackLayout>
</ContentPage>