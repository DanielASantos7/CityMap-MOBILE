<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mobile.Views.ListRestaurantsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="WhiteSmoke"
    Shell.NavBarIsVisible="False">

    <Grid Padding="10" RowDefinitions="Auto, *">

        <!--  FILTRO SUPERIOR  -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,10"
            ColumnDefinitions="Auto, *"
            ColumnSpacing="10">
            <Label
                Grid.Column="0"
                FontSize="16"
                Text="Filtro:"
                TextColor="Black"
                VerticalOptions="Center" />

            <Picker
                x:Name="pkFiltro"
                Title="Selecione um filtro"
                Grid.Column="1"
                FontSize="16"
                HorizontalOptions="Fill"
                SelectedIndexChanged="OnFiltroChanged"
                TextColor="Black">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Todos</x:String>
                        <x:String>Restaurante</x:String>
                        <x:String>Atração</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
        </Grid>

        <!--  LISTA DE ESTABELECIMENTOS  -->
        <CollectionView
            x:Name="cvLista"
            Grid.Row="1"
            Margin="0,5"
            SelectionChanged="OnItemSelecionado"
            SelectionMode="Single">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="5,5,5,10"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0">
                        <Grid
                            Padding="10"
                            ColumnDefinitions="Auto, *"
                            ColumnSpacing="10">

                            <!--  IMAGEM DE CAPA  -->
                            <Image
                                Grid.Column="0"
                                Aspect="AspectFill"
                                HeightRequest="80"
                                Source="{Binding Imagem}"
                                WidthRequest="80" />

                            <!--  INFORMAÇÕES À DIREITA  -->
                            <Grid
                                Grid.Column="1"
                                RowDefinitions="Auto, *"
                                RowSpacing="5"
                                VerticalOptions="Center">

                                <!--  LINHA 1: TAG TIPO + NOME  -->
                                <Grid
                                    Grid.Row="0"
                                    ColumnDefinitions="Auto, *"
                                    ColumnSpacing="6">
                                    <Border
                                        Grid.Column="0"
                                        BackgroundColor="{Binding CorTag}"
                                        StrokeShape="RoundRectangle 4"
                                        StrokeThickness="0">
                                        <Label
                                            Padding="6,2"
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            Text="{Binding TipoTag}"
                                            TextColor="White" />
                                    </Border>
                                    <Label
                                        Grid.Column="1"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding Nome}"
                                        TextColor="Black" />
                                </Grid>

                                <!--  LINHA 2: DISTÂNCIA + RATING  -->
                                <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
                                    <Label
                                        Grid.Column="0"
                                        FontSize="13"
                                        Text="{Binding DistanciaFormatada}"
                                        TextColor="Gray"
                                        VerticalOptions="Center" />

                                    <HorizontalStackLayout
                                        Grid.Column="1"
                                        Spacing="3"
                                        VerticalOptions="Center">
                                        <Label Text="⭐" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            Text="{Binding Rating}"
                                            TextColor="Gray" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Grid>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>