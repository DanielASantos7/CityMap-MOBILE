<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mobile.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Profile"
    BackgroundColor="#F8F9FA">

    <Grid Padding="20">

        <!--  1. ESTADO DESLOGADO  -->
        <VerticalStackLayout
            x:Name="layoutDeslogado"
            IsVisible="True"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                FontAttributes="Bold"
                FontSize="22"
                HorizontalOptions="Center"
                Text="Not logged in"
                TextColor="#333333" />

            <Button
                BackgroundColor="White"
                BorderColor="#CCCCCC"
                BorderWidth="1"
                Clicked="OnLoginClicked"
                CornerRadius="6"
                HeightRequest="42"
                HorizontalOptions="Center"
                Text="Log in"
                TextColor="#333333"
                WidthRequest="160" />
        </VerticalStackLayout>

        <!--  2. ESTADO LOGADO  -->
        <VerticalStackLayout
            x:Name="layoutLogado"
            IsVisible="False"
            Spacing="20">

            <!--  Informações do Usuário  -->
            <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                <Border
                    BackgroundColor="#E0E0E0"
                    HeightRequest="60"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 30"
                    WidthRequest="60">
                    <Image
                        x:Name="imgAvatar"
                        Aspect="AspectFill"
                        Source="dotnet_bot.png" />
                </Border>

                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label
                        x:Name="lblUserName"
                        FontAttributes="Bold"
                        FontSize="18"
                        TextColor="#1A1A1A" />
                    <Label
                        x:Name="lblEmail"
                        FontSize="13"
                        TextColor="#777777" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <BoxView
                Margin="0,10"
                HeightRequest="1"
                Color="#E5E7EB" />

            <!--  Opção My Reviews  -->
            <Border
                Padding="16"
                BackgroundColor="White"
                Stroke="#E0E0E0"
                StrokeShape="RoundRectangle 8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMyReviewsTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Label
                        Margin="0,0,10,0"
                        FontSize="16"
                        Text="💬"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="15"
                        Text="My Reviews"
                        TextColor="#333333"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="2"
                        FontSize="16"
                        Text="&gt;"
                        TextColor="#999999"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!--  Botão LOGOUT  -->
            <Button
                Margin="0,40,0,0"
                BackgroundColor="#0066CC"
                Clicked="OnLogoutClicked"
                CornerRadius="8"
                FontAttributes="Bold"
                HeightRequest="44"
                Text="LOGOUT"
                TextColor="White" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>